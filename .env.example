# Local Hardhat node started by `npm run chain`. The demo does not need testnet funds.
LOCAL_RPC_URL=http://127.0.0.1:18545

# Portaldot V3 testnet. Defaults match the Portaldot team guide updated 16 Oct 2026.
# Guide: https://github.com/ItsCogumellum/portaldot-v3-testnet-guide
# Override these if the organiser rotates the endpoints. Chain id stays 420420777
# unless a future guide says otherwise.
PORTALDOT_RPC_URL=https://test-evm-rpc-v3.portaldot.dev
PORTALDOT_CHAIN_ID=420420777
PORTALDOT_SUBSTRATE_RPC=wss://test-node-v3.portaldot.dev

# Testnet deployer only. Never commit a real key. Never paste the Hardhat demo mnemonic here.
# Fund the mapped native POT address (see README) with tPOTv3 before deploying.
DEPLOYER_PRIVATE_KEY=

# Optional. When unset, the deployer holds admin, CFO, attester, and arbiter.
ATTESTER_ADDRESS=
CFO_ADDRESS=
ARBITER_ADDRESS=
AGENT_ADDRESS=
BUYER_ADDRESS=
SELLER_ADDRESS=

# Agent one-shot (`npm run agent`). Amounts are oUSD base units (6 decimals).
# 15000000000 = 15,000 oUSD. Cap in the sample shipment is 20,000 oUSD.
ESCROW_ID=1
AMOUNT=15000000000
# Set WATCH=1 to poll. MAX_RELEASES bounds how many under-cap tranches one process may send.
WATCH=0
MAX_RELEASES=1
POLL_MS=4000
